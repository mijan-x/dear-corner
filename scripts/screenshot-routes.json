{
  "viewports": [
    {
      "name": "360",
      "width": 360,
      "height": 780
    },
    {
      "name": "768",
      "width": 768,
      "height": 1024
    },
    {
      "name": "1280",
      "width": 1280,
      "height": 800
    }
  ],
  "routes": [
    {
      "name": "home",
      "path": "/"
    },
    {
      "name": "styleguide",
      "path": "/styleguide"
    },
    {
      "name": "not-found",
      "path": "/this-page-does-not-exist"
    },
    {
      "name": "shop",
      "path": "/shop"
    },
    {
      "name": "category",
      "path": "/shop/lighting"
    },
    {
      "name": "collection",
      "path": "/collections/new-arrivals"
    },
    {
      "name": "search-results",
      "path": "/search?q=lamp"
    },
    {
      "name": "search-none",
      "path": "/search?q=sofa",
      "viewports": ["360", "1280"]
    },
    {
      "name": "filtered",
      "path": "/shop?color=Sage&sort=price_desc",
      "viewports": ["360", "1280"]
    },
    {
      "name": "product",
      "path": "/products/sample-pleated-table-lamp"
    },
    {
      "name": "product-sizes",
      "path": "/products/sample-linen-photo-frame",
      "viewports": ["360", "1280"]
    },
    {
      "name": "product-sold-out",
      "path": "/products/sample-mushroom-night-lamp",
      "viewports": ["360"]
    },
    {
      "name": "product-color",
      "path": "/products/sample-ribbed-ceramic-bud-vase",
      "viewports": ["1280"],
      "fullPage": false,
      "actions": [
        {
          "click": "fieldset label[title='Clay']",
          "wait": 600
        }
      ]
    },
    {
      "name": "filter-sheet",
      "path": "/shop",
      "viewports": ["360", "768"],
      "fullPage": false,
      "actions": [
        {
          "click": "main button:has-text('Filter')",
          "wait": 600
        }
      ]
    },
    {
      "name": "sort-sheet",
      "path": "/shop",
      "viewports": ["360"],
      "fullPage": false,
      "actions": [
        {
          "click": "main button:has-text('Sort')",
          "wait": 600
        }
      ]
    },
    {
      "name": "menu-open",
      "path": "/",
      "viewports": ["360", "768"],
      "fullPage": false,
      "actions": [
        {
          "click": "button[aria-label='Open menu']",
          "wait": 500
        }
      ]
    },
    {
      "name": "search-open",
      "path": "/",
      "fullPage": false,
      "actions": [
        {
          "click": "button[aria-label='Search']",
          "wait": 500
        }
      ]
    },
    {
      "name": "shop-panel",
      "path": "/",
      "viewports": ["1280"],
      "fullPage": false,
      "actions": [
        {
          "hover": "nav[aria-label='Main'] button[aria-expanded]",
          "wait": 500
        }
      ]
    },
    {
      "name": "header-scrolled",
      "path": "/styleguide",
      "viewports": ["360", "1280"],
      "fullPage": false,
      "actions": [
        {
          "click": "a[href='#cards']:visible",
          "wait": 600
        }
      ]
    },
    {
      "name": "cart-drawer",
      "path": "/styleguide",
      "viewports": ["360", "1280"],
      "fullPage": false,
      "actions": [
        {
          "click": "a[href='#overlays']:visible",
          "wait": 400
        },
        {
          "click": "button:has-text('Cart drawer')",
          "wait": 500
        }
      ]
    },
    {
      "name": "cart",
      "path": "/cart",
      "cart": [
        "sample-pleated-table-lamp",
        "sample-warm-fairy-lights",
        "sample-grid-notebook-a5"
      ]
    },
    {
      "name": "cart-empty",
      "path": "/cart",
      "viewports": ["360"]
    },
    {
      "name": "cart-drawer-live",
      "path": "/products/sample-bubble-candle-set-of-2",
      "viewports": ["360", "1280"],
      "fullPage": false,
      "cart": ["sample-warm-fairy-lights"],
      "actions": [
        {
          "click": "main button:has-text('Add to cart')",
          "wait": 900
        }
      ]
    },
    {
      "name": "checkout",
      "path": "/checkout",
      "cart": [
        "sample-pleated-table-lamp",
        "sample-warm-fairy-lights",
        "sample-grid-notebook-a5"
      ]
    },
    {
      "name": "checkout-filled",
      "path": "/checkout",
      "cart": ["sample-bubble-candle-set-of-2", "sample-claw-hair-clip-set"],
      "viewports": ["360", "1280"],
      "actions": [
        {
          "fill": "#checkout-name",
          "value": "Nabila Hasan"
        },
        {
          "fill": "#checkout-phone",
          "value": "01812345678"
        },
        {
          "select": "#checkout-division",
          "value": "Dhaka"
        },
        {
          "select": "#checkout-district",
          "value": "Dhaka"
        },
        {
          "select": "#checkout-area",
          "value": "Mirpur"
        },
        {
          "fill": "#checkout-address",
          "value": "House 3, Road 11, Block D",
          "wait": 1200
        }
      ]
    },
    {
      "name": "checkout-errors",
      "path": "/checkout",
      "cart": ["sample-bubble-candle-set-of-2", "sample-claw-hair-clip-set"],
      "viewports": ["360"],
      "fullPage": false,
      "actions": [
        {
          "click": "button[form='checkout-form']:visible",
          "wait": 600
        }
      ]
    },
    {
      "name": "checkout-signed-in",
      "path": "/checkout",
      "cart": ["sample-bubble-candle-set-of-2", "sample-claw-hair-clip-set"],
      "session": true,
      "viewports": ["768", "1280"]
    },
    {
      "name": "order-confirmed",
      "path": "/order-confirmed/{order}",
      "session": true
    },
    {
      "name": "track-order",
      "path": "/track-order",
      "viewports": ["360", "1280"]
    },
    {
      "name": "track-result",
      "path": "/track-order?order={order}",
      "actions": [
        {
          "fill": "#track-phone",
          "value": "{phone}"
        },
        {
          "click": "main button:has-text('Track order')",
          "wait": 1200
        }
      ]
    },
    {
      "name": "sign-in",
      "path": "/account/sign-in",
      "viewports": ["360", "1280"]
    },
    {
      "name": "sign-in-code",
      "path": "/account/sign-in",
      "viewports": ["360"],
      "fullPage": false,
      "cart": [],
      "actions": [
        {
          "fill": "input[type='email']",
          "value": "rima@example.com"
        },
        {
          "click": "main button:has-text('Email me a code')",
          "wait": 900
        }
      ]
    },
    {
      "name": "account-orders",
      "path": "/account",
      "session": true
    },
    {
      "name": "account-order",
      "path": "/account/orders/{delivered}",
      "session": true
    },
    {
      "name": "review-dialog",
      "path": "/account/orders/{delivered}",
      "session": true,
      "viewports": ["360", "1280"],
      "fullPage": false,
      "actions": [
        {
          "click": "main button:has-text('Write a review')",
          "wait": 600
        }
      ]
    },
    {
      "name": "addresses",
      "path": "/account/addresses",
      "session": true,
      "viewports": ["360", "1280"]
    },
    {
      "name": "address-dialog",
      "path": "/account/addresses",
      "session": true,
      "viewports": ["360"],
      "fullPage": false,
      "actions": [
        {
          "click": "main button:has-text('Add an address')",
          "wait": 700
        }
      ]
    },
    {
      "name": "profile",
      "path": "/account/profile",
      "session": true,
      "viewports": ["360", "1280"]
    },
    {
      "name": "wishlist",
      "path": "/account/wishlist",
      "session": true
    }
  ]
}
