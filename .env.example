# Copy to .env.local for local development. Never commit real values.
# Supabase project: Dear-Corner-SG (Singapore). Find both values in
# Supabase dashboard -> Project Settings -> API (or "Connect").
VITE_SUPABASE_URL=
# The anon / publishable key (starts with eyJ... or sb_publishable_...).
# It is safe in the browser; Row Level Security protects the data.
VITE_SUPABASE_ANON_KEY=
# Public site address used for share (Open Graph) links. Optional.
VITE_SITE_URL=https://dearcornerbd.vercel.app
